# Copy this file to .env.devbox or .env.remote on the server and fill secrets

# --- Database (internal Postgres service) ---
POSTGRES_DB=shathyar
POSTGRES_USER=shathyar
POSTGRES_PASSWORD=change_me

# If using external DB, comment out the internal DB envs above and set SHATHYAR_DB_URL explicitly.
# Example for external cluster:
# SHATHYAR_DB_URL=postgresql+psycopg://postgres:password@db-host:5432/postgres?sslmode=require

# --- AI Provider (Volcengine ARK) ---
SHATHYAR_AI_API_KEY=your_ark_api_key
SHATHYAR_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
SHATHYAR_AI_MODEL=doubao-seed-1-6-flash-250828
SHATHYAR_AI_TIMEOUT=60

# --- CORS ---
# Comma-separated list of allowed origins, e.g. https://example.com,https://www.example.com
SHATHYAR_CORS_ORIGINS=*

