###############################################
# Devbox Deployment Environment (example)
# Copy to .env and fill your real values.
# This file is safe to commit; .env is gitignored.
###############################################

# --- Remote host via SSH ---
DEVBOX_SSH_HOST=hzh.sealos.run
DEVBOX_SSH_PORT=32632
DEVBOX_SSH_USER=devbox
# Path to your private key on YOUR local machine (not stored in repo)
DEVBOX_SSH_KEY_PATH=~/.ssh/devbox_snathyar

# --- Git repository ---
# SSH URL to this repo (adjust for your origin)
REMOTE_REPO_SSH=git@github.com:YOUR_ORG/SnathYarTranslation.git
REMOTE_DIR=~/apps/snathyar
DEPLOY_BRANCH=devbox-deploy

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Override DB (SQLite or Postgres). Example for Postgres:
# SHATHYAR_DB_URL=postgresql://postgres:password@hostname:5432/postgres
SHATHYAR_DB_URL=
# CORS origins for production, comma-separated (optional)
CORS_ORIGINS=

# --- Frontend ---
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# Frontend dev proxy target to backend
# Used by Vite dev server to reach backend from browser
VITE_BACKEND_PROXY_TARGET=http://localhost:8000

# Optional: public API base URL for axios when not using proxy
# Example: https://lkpbpxyjfjja.sealoshzh.site/api/v1
VITE_API_BASE_URL=

# --- External providers & secrets (examples) ---
# Keep your keys here; scripts will export them at runtime
VOLC_API_KEY=
OPENAI_API_KEY=
ANY_OTHER_SECRET=

